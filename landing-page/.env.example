# Variáveis da função de e-mail. No Netlify: Site configuration > Environment variables.
# Para testar no PC com "netlify dev", copie para .env

# Chave da API da Brevo (SMTP & API > Chaves de API)
BREVO_API_KEY=

# E-mail verificado como remetente na Brevo
EMAIL_REMETENTE=

# Quem recebe as mensagens do formulário.
# TESTE COM O SEU E-MAIL! Só na entrega troque para: sandro.ramos@prof.unipar.br
EMAIL_DESTINO=
